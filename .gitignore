# Build output
dist/*
!dist/.gitkeep
src-tauri/target/
src-tauri/gen/schemas/
build/appimage/cache/*
!build/appimage/cache/.gitkeep
build/exe/cache/*
!build/exe/cache/.gitkeep
build/apk/cache/*
!build/apk/cache/.gitkeep
src-tauri/gen/android/

# Runtime data
.env
docker/data/jobs/*.json
docker/data/trash/
docker/data/presets.json
docker/data/**/*.tmp

# Local source assets
assets/newlogo.png
assets/favicon.png

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.directory

# Defensive ignore rules
.env.*
!**/.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
local.properties
*.apk
*.aab
